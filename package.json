{
  "name": "bio-evidence",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Collaborative research workspace with local private materials and cited public evidence",
  "type": "module",
  "private": true,
  "trustedDependencies": [
    "@sentry/cli",
    "@vscode/ripgrep",
    "electron",
    "electron-winstaller",
    "esbuild",
    "koffi",
    "protobufjs",
    "sharp"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "!apps/online-docs"
  ],
  "scripts": {
    "bio:server": "node scripts/bio-start.mjs server",
    "bio:desktop": "node scripts/bio-start.mjs desktop",
    "bio:account": "node scripts/bio-launch.mjs runtime run packages/server/src/bio-account.ts",
    "bio:web:build": "node scripts/bio-launch.mjs build run scripts/bio-renderer-build.ts web",
    "bio:desktop:build": "node scripts/bio-launch.mjs build run scripts/bio-electron-build.ts && node scripts/bio-launch.mjs build run scripts/bio-renderer-build.ts desktop",
    "test": "node scripts/bio-tests.mjs",
    "test:bio": "node scripts/bio-launch.mjs test test packages/research-core/src packages/shared/src/protocol/__tests__/research.test.ts packages/server-core/src/research",
    "bio:typecheck": "tsc --noEmit -p packages/research-core/tsconfig.json",
    "typecheck": "bun run typecheck:shared",
    "typecheck:shared": "cd packages/shared && bun run tsc --noEmit",
    "typecheck:staged": "bash scripts/typecheck-staged.sh",
    "typecheck:all": "cd packages/core && bun run tsc --noEmit && cd ../shared && bun run tsc --noEmit && cd ../server-core && bun run tsc --noEmit && cd ../server && bun run tsc --noEmit && cd ../session-tools-core && bun run tsc --noEmit && cd ../pi-agent-server && bun run typecheck && cd ../../apps/electron && bun run typecheck && cd ../../packages/ui && bun run tsc --noEmit",
    "server:start": "node scripts/bio-start.mjs server",
    "server:dev": "node scripts/bio-disabled-entry.mjs",
    "server:build": "node scripts/bio-disabled-entry.mjs",
    "server:build:linux-x64": "node scripts/bio-disabled-entry.mjs",
    "server:build:linux-arm64": "node scripts/bio-disabled-entry.mjs",
    "server:build:darwin-arm64": "node scripts/bio-disabled-entry.mjs",
    "server:build:darwin-x64": "node scripts/bio-disabled-entry.mjs",
    "typecheck:electron": "cd apps/electron && bun run typecheck",
    "test:shared:llm-connections": "cd packages/shared && bun test tests/llm-connections.test.ts",
    "test:shared:models-pi": "cd packages/shared && bun test tests/models-pi.test.ts",
    "test:shared:config": "cd packages/shared && bun test src/config/__tests__/llm-connections.test.ts src/config/__tests__/storage-migrations.test.ts src/config/__tests__/storage-startup-migration.test.ts src/config/__tests__/default-thinking-level.test.ts",
    "test:shared:all": "bun run test:shared:llm-connections && bun run test:shared:models-pi && bun run test:shared:config",
    "test:doc-tools": "node scripts/bio-disabled-entry.mjs",
    "validate:dev": "node scripts/bio-validate.mjs",
    "validate:ci": "node scripts/bio-validate.mjs",
    "lint:ipc-sends": "bash scripts/check-raw-sends.sh",
    "lint:tool-name-checks": "bash scripts/check-task-tool-checks.sh",
    "lint:electron": "cd apps/electron && bun run lint",
    "lint:shared": "cd packages/shared && npx eslint .",
    "lint:ui": "cd packages/ui && npx eslint .",
    "lint:i18n:staged": "bash scripts/lint-i18n-staged.sh",
    "lint:i18n:strings": "bash scripts/lint-i18n-strings.sh",
    "lint:i18n:parity": "bun run scripts/check-i18n-parity.ts",
    "lint:i18n:coverage": "bun run scripts/check-i18n-coverage.ts",
    "sort-locales": "bun scripts/sort-locales.ts",
    "lint:i18n:sorted": "bun scripts/sort-locales.ts --check",
    "lint": "bun run lint:ipc-sends && bun run lint:tool-name-checks && bun run lint:electron && bun run lint:shared && bun run lint:ui",
    "link": "node scripts/bio-disabled-entry.mjs",
    "electron:clean": "node scripts/bio-disabled-entry.mjs",
    "electron:build:main": "node scripts/bio-disabled-entry.mjs",
    "electron:build:preload": "node scripts/bio-disabled-entry.mjs",
    "electron:build:renderer": "node scripts/bio-disabled-entry.mjs",
    "electron:build:resources": "node scripts/bio-disabled-entry.mjs",
    "build:wa-worker": "bun run scripts/build-wa-worker.ts",
    "electron:build:assets": "node scripts/bio-disabled-entry.mjs",
    "electron:build": "bun run bio:desktop:build",
    "electron:start": "node scripts/bio-start.mjs desktop",
    "electron:dev": "node scripts/bio-disabled-entry.mjs",
    "electron:dev:terminal": "node scripts/bio-disabled-entry.mjs",
    "electron:dev:menu": "node scripts/bio-disabled-entry.mjs",
    "electron:dev:logs": "node scripts/bio-disabled-entry.mjs",
    "sync-secrets": "node scripts/bio-disabled-entry.mjs",
    "fresh-start": "node scripts/bio-disabled-entry.mjs",
    "fresh-start:token": "node scripts/bio-disabled-entry.mjs",
    "print:system-prompt": "bun run packages/shared/src/prompts/print-system-prompt.ts",
    "browser-tool": "bun run scripts/browser-tool.ts",
    "electron:dist": "node scripts/bio-disabled-entry.mjs",
    "electron:dist:mac": "node scripts/bio-disabled-entry.mjs",
    "electron:dist:win": "node scripts/bio-disabled-entry.mjs",
    "electron:dist:linux": "node scripts/bio-disabled-entry.mjs",
    "electron:dist:dev:mac": "node scripts/bio-disabled-entry.mjs",
    "electron:dist:dev:win": "node scripts/bio-disabled-entry.mjs",
    "electron:dist:dev:linux": "node scripts/bio-disabled-entry.mjs",
    "playground:dev": "node scripts/bio-disabled-entry.mjs",
    "viewer:dev": "node scripts/bio-disabled-entry.mjs",
    "viewer:typecheck": "cd apps/viewer && bun run typecheck",
    "viewer:build": "vite build --config apps/viewer/vite.config.ts",
    "viewer:preview": "vite preview --config apps/viewer/vite.config.ts",
    "webui:dev": "node scripts/bio-disabled-entry.mjs",
    "webui:clean": "node scripts/bio-disabled-entry.mjs",
    "webui:build": "bun run bio:web:build",
    "webui:typecheck": "cd apps/webui && bun run typecheck",
    "server:build:subprocess": "node scripts/bio-disabled-entry.mjs",
    "server:prod": "node scripts/bio-disabled-entry.mjs",
    "server:dev:webui": "node scripts/bio-disabled-entry.mjs",
    "marketing:dev": "node scripts/bio-disabled-entry.mjs",
    "marketing:build": "node scripts/bio-disabled-entry.mjs",
    "marketing:preview": "node scripts/bio-disabled-entry.mjs",
    "docs:dev": "node scripts/bio-disabled-entry.mjs",
    "build": "bun run bio:web:build && bun run bio:desktop:build",
    "release": "node scripts/bio-disabled-entry.mjs",
    "check-version": "node scripts/bio-disabled-entry.mjs",
    "oss:sync": "node scripts/bio-disabled-entry.mjs",
    "prepare": "husky",
    "bio:resources": "node scripts/bio-launch.mjs test run packages/server/src/bio-resources.ts",
    "bio:server:package": "node scripts/bio-launch.mjs build run scripts/bio-server-package.ts",
    "bio:desktop:package": "node scripts/bio-launch.mjs build run scripts/bio-desktop-package.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.947.0",
    "@electron/packager": "^19.0.1",
    "@rollup/rollup-win32-arm64-msvc": "^4.55.1",
    "@sentry/vite-plugin": "^4.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "1.3.6",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/linkify-it": "^5.0.0",
    "@types/node": "^25.0.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.7.1",
    "@types/shell-quote": "^1.7.5",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "openai": "^6.18.0",
    "postcss": "^8.5.6",
    "react-devtools-core": "^6.1.1",
    "tailwindcss": "^4.1.18",
    "tar": "^7.5.2",
    "typescript": "^5.0.0",
    "vite": "^6.2.4"
  },
