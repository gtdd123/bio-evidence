# BioEvidence Multi-Client Agent Platform - Environment Configuration Example

# Server Network & Cluster Binding
BIO_HOST=0.0.0.0
BIO_PORT=9100
BIO_PUBLIC_ORIGIN=https://bio-evidence.lab.example.org:9100

# Model Gateway Configuration (Managed at runtime via CredentialManager; optional fallback env vars)
# Supports Local GPU Cluster (vLLM / Ollama / SGLang) or Cloud OpenAI/Anthropic Compatible Endpoints
OPENAI_API_BASE_URL=https://llm-4090.lab.internal/v1
OPENAI_API_KEY=sk-your-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Europe PMC & Biomedical Literature Provider Settings
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
LITERATURE_REQUEST_TIMEOUT_MS=15000

# Security & PreToolUse Execution Policy (safe | ask | allow-all)
DEFAULT_PERMISSION_MODE=ask
