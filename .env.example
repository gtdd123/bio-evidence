# BioEvidence server-only model environment template.
# Inject through your shell, service manager or container Secret.
# The isolated launcher does not automatically load repository .env files.
# Never prefix secrets with VITE_. Static demo needs no API keys.

OPENAI_API_KEY=
# Optional. Empty uses official OpenAI Responses. Custom HTTPS bases use Chat Completions.
OPENAI_API_BASE_URL=
OPENAI_MODELS=gpt-4o,gpt-4.1-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# Lab endpoint must provide HTTPS; use a TLS reverse proxy for an HTTP-only model server.
LAB_API_BASE_URL=
LAB_API_KEY=
LAB_MODEL=

# Non-secret build switch; creates apps/webui/dist-demo.
VITE_DEMO_MODE=false

# Network, TLS and directory grants are configured in .runtime/runtime/service.json
# and material-grants.json, not through unsupported environment aliases.
