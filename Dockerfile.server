# BioEvidence source service image. Linux/container execution is not yet verified.
FROM oven/bun:1.3.10-slim AS bun-runtime
FROM node:24.13.0-bookworm-slim AS build
COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /opt/bio-evidence
COPY . .
RUN node scripts/bio-prepare.mjs --bun /usr/local/bin/bun
RUN node scripts/bio-launch.mjs install install --frozen-lockfile
RUN node scripts/bio-launch.mjs build run scripts/bio-renderer-build.ts web

FROM node:24.13.0-bookworm-slim
LABEL org.opencontainers.image.source="https://github.com/gtdd123/bio-evidence"
LABEL org.opencontainers.image.description="BioEvidence research service (source runtime)"
LABEL org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /opt/bio-evidence
COPY --from=build --chown=node:node /opt/bio-evidence /opt/bio-evidence
USER node
EXPOSE 9100
VOLUME ["/opt/bio-evidence/.runtime/runtime"]
# Configure remote TLS/publicOrigin in the mounted service.json. Defaults bind loopback.
CMD ["node", "scripts/bio-start.mjs", "server"]
